#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    default_transform: key_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <5>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row"; // ※もし反応しなければ row2col に変えます
        row-gpios
            = <&gpio0 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row_0 (006)
            , <&gpio1 0  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row_1 (100)
            , <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row_2 (113)
            , <&gpio1 4  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>; // Row_3 (104)
        col-gpios
            = <&gpio0 24 GPIO_ACTIVE_HIGH> // Col_0 (024)
            , <&gpio0 11 GPIO_ACTIVE_HIGH> // Col_1 (011)
            , <&gpio1 11 GPIO_ACTIVE_HIGH> // Col_2 (111)
            , <&gpio0 2  GPIO_ACTIVE_HIGH> // Col_3 (002)
            , <&gpio1 15 GPIO_ACTIVE_HIGH>; // Col_4 (115)
    };
};
